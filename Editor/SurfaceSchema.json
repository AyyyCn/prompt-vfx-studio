{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "duration": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "segmentsU": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "segmentsV": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "copies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "blend": {
            "type": "string",
            "enum": [
              "alpha",
              "additive"
            ]
          },
          "helpers": {
            "type": "string",
            "minLength": 0,
            "maxLength": 10000
          },
          "geometry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "shading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "id",
          "segmentsU",
          "segmentsV",
          "copies",
          "blend",
          "helpers",
          "geometry",
          "shading"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "duration",
    "layers"
  ],
  "additionalProperties": false
}
