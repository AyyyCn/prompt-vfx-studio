{
  "name": "com.arcade.vfx-author",
  "version": "0.5.3",
  "displayName": "Prompt VFX Studio",
  "description": "Generate an original Unity VFX prefab from a prompt. Review two rendered drafts and import your choice.",
  "unity": "6000.3",
  "dependencies": {
    "com.unity.nuget.newtonsoft-json": "3.2.1",
    "com.unity.modules.particlesystem": "1.0.0",
    "com.unity.render-pipelines.universal": "17.3.0"
  },
  "samples": [
    {
      "displayName": "Legacy particle examples",
